@prefix : <http://www.semanticweb.org/soap#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix soap: <http://www.semanticweb.org/soap#> .
@base <http://www.semanticweb.org/soap#> .

<http://www.semanticweb.org/soap> rdf:type owl:Ontology ;
                                   owl:versionIRI <http://www.semanticweb.org/soap/26.1> ;
                                   dc:created "2026-01-08T02:13:00" ;
                                   dc:creator "Nicolas Dix" ;
                                   dc:license <https://www.apache.org/licenses/LICENSE-2.0> ;
                                   rdfs:comment "SOAP provides a formal, machine-interpretable model for representing preference data and collective decision outcomes. It aims to enable semantic interoperability between heterogeneous datasets by abstracting from format-specific encodings and making core concepts such as agents, preferences, alternatives, and contextual metadata explicit. The ontology is designed to support comparison, querying, and transformation of preference data across different sources and representations, with a particular focus on ranked, categorical, and incomplete preferences."@en ;
                                   rdfs:label "SOAP Ontology for Aligned Preferences"@en ;
                                   owl:versionInfo 26.1 .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/created
dc:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/license
dc:license rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/soap#hasAvailableOption
soap:hasAvailableOption rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf owl:topObjectProperty ;
                        rdfs:domain soap:Context ;
                        rdfs:range soap:Option ;
                        rdfs:comment "Links a context to the options that are available for selection within a given decision situation. This property defines the set of alternatives from which agents may choose when expressing their preferences, independently of whether an option is referenced in a particular ballot."@en ;
                        rdfs:label "has available option"@en .


###  http://www.semanticweb.org/soap#hasBallotEntry
soap:hasBallotEntry rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdfs:domain soap:Ballot ;
                    rdfs:range soap:BallotEntry ;
                    rdfs:comment "Links a ballot to a BallotEntry instance that represents the participation of a specific option in a particular preference expression. This intermediate construct allows contextual attributes such as rank, category, or score to be attached to an option as expressed on a given ballot, without treating these attributes as intrinsic properties of the option itself."@en ;
                    rdfs:label "has ballot entry"@en .


###  http://www.semanticweb.org/soap#hasContext
soap:hasContext rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:domain soap:Ballot ;
                rdfs:range soap:Context ;
                rdfs:comment "Links a ballot to the context in which it was expressed, such as an election, survey, or experiment. This enables preference expressions to be interpreted and compared with respect to their situational setting."@en ;
                rdfs:label "has context"@en .


###  http://www.semanticweb.org/soap#hasExpressed
soap:hasExpressed rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:domain soap:Actor ;
                  rdfs:range soap:Ballot ;
                  rdfs:comment "Links a ballot to the agent that expressed it. This property supports explicit attribution of preference expressions independently of the original data format or identifier conventions."@en ;
                  rdfs:label "has expressed"@en .


###  http://www.semanticweb.org/soap#producesResult
soap:producesResult rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdfs:domain soap:Context ;
                    rdfs:range soap:Result ;
                    rdfs:comment "Links a ballot to the context in which it was expressed, such as an election, survey, or experiment. This enables preference expressions to be interpreted and compared with respect to their situational setting.en"@en ;
                    rdfs:label "produces result"@en .


###  http://www.semanticweb.org/soap#refersToOption
soap:refersToOption rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdfs:domain soap:BallotEntry ;
                    rdfs:range soap:Option ;
                    rdfs:comment "Links a Ballot Entry to the (universal) Option it represents on a specific ballot."@en ;
                    rdfs:label "refers to option"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/soap#hasMultiplicity
soap:hasMultiplicity rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:domain soap:Ballot ;
                     rdfs:range xsd:int ;
                     rdfs:comment "Number of agents who submitted this exact ballot"@en ;
                     rdfs:label "has multiplicity"@en .


###  http://www.semanticweb.org/soap#hasRank
soap:hasRank rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain soap:BallotEntry ;
             rdfs:range xsd:int ;
             rdfs:comment "Ordinal position in ranking"@en ;
             rdfs:label "has rank"@en .


###  http://www.semanticweb.org/soap#hasVoteCount
soap:hasVoteCount rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty ;
                  rdfs:domain soap:BallotEntry ;
                  rdfs:range xsd:int ;
                  rdfs:comment "Number of votes for an option"@en ;
                  rdfs:label "has vote count"@en .


###  http://www.semanticweb.org/soap#hasWeight
soap:hasWeight rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               rdfs:domain soap:Ballot ,
                           soap:BallotEntry ;
               rdfs:range xsd:float ;
               rdfs:comment "Influence / strength (contextual)"@en ;
               rdfs:label "has weight"@en .


###  http://www.semanticweb.org/soap#isValid
soap:isValid rdf:type owl:DatatypeProperty ;
             rdfs:domain soap:Ballot ;
             rdfs:range xsd:boolean ;
             rdfs:comment "Record validity"@en ;
             rdfs:label "is valid"@en .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/soap#Actor
soap:Actor rdf:type owl:Class ;
           rdfs:subClassOf owl:Thing ;
           rdfs:comment "An entity capable of expressing preferences in a collective decision making setting. Agents may represent individuals, groups, organizations, or other participants, and are modeled independently of any particular data format to enable unambiguous attribution of preference expressions."@en ;
           rdfs:label "Agent"@en ;
           skos:altLabel "Actor"@en ,
                         "Decision-maker"@en ,
                         "Participant"@en ,
                         "Stakeholder"@en ,
                         "Subject"@en ,
                         "Voter"@en .


###  http://www.semanticweb.org/soap#AggregatedBallot
soap:AggregatedBallot rdf:type owl:Class ;
                      rdfs:subClassOf soap:Ballot ;
                      rdfs:label "Aggregated Ballot"@en .


###  http://www.semanticweb.org/soap#Ballot
soap:Ballot rdf:type owl:Class ;
            rdfs:subClassOf owl:Thing ;
            rdfs:comment "A concrete preference expression submitted by an agent within a given context. A ballot captures how preferences are expressed (e.g., ranked, tied, categorical, complete or incomplete) and serves as the primary unit for representing preference data independently of format-specific encodings."@en ;
            rdfs:label "Ballot"@en ;
            skos:altLabel "Vote"@en .


###  http://www.semanticweb.org/soap#BallotEntry
soap:BallotEntry rdf:type owl:Class ;
                 rdfs:subClassOf owl:Thing ;
                 rdfs:comment "Represents the participation of a specific option in a specific ballot. A BallotOption captures contextual attributes of an option as it is expressed within a particular preference expression such as rank, category, or score, without treating these attributes as intrinsic properties of the option itself."@en ;
                 rdfs:label "Ballot Entry"@en ;
                 skos:altLabel "Ballot item"@en ,
                               "Preference entry"@en .


###  http://www.semanticweb.org/soap#CategoricalBallot
soap:CategoricalBallot rdf:type owl:Class ;
                       rdfs:subClassOf soap:Ballot ;
                       rdfs:comment "A ballot in which an agent assigns options to one or more categories, such as approval, rejection, or indifference. This class abstracts from specific category semantics and supports preference expressions that are not based on explicit rankings."@en ;
                       rdfs:label "Categorical Ballot" .


###  http://www.semanticweb.org/soap#CompleteBallot
soap:CompleteBallot rdf:type owl:Class ;
                    rdfs:subClassOf soap:Ballot ;
                    rdfs:comment "A ballot that references all options available in the associated context. This classification reflects completeness of the preference expression without imposing assumptions about preference structure or ordering."@en ;
                    rdfs:label "Complete Ballot"@en .


###  http://www.semanticweb.org/soap#Context
soap:Context rdf:type owl:Class ;
             rdfs:subClassOf owl:Thing ;
             rdfs:comment "The situational environment in which preferences are expressed and interpreted, such as an election, survey, or experiment. Context provides the semantic frame for preference expressions and outcomes, allowing datasets to be compared while keeping procedural and legal aspects out of scope."@en ;
             rdfs:label "Context"@en ;
             skos:altLabel "Circumstance"@en ,
                           "Condition"@en ,
                           "Environment"@en ,
                           "Scenario"@en ,
                           "Situation"@en .


###  http://www.semanticweb.org/soap#IncompleteBallot
soap:IncompleteBallot rdf:type owl:Class ;
                      rdfs:subClassOf soap:Ballot ;
                      rdfs:comment "A ballot that references only a subset of the options available in the associated context. This class allows partial or truncated preference expressions to be distinguished without interpreting omitted options."@en ;
                      rdfs:label "Incomplete Ballot"@en .


###  http://www.semanticweb.org/soap#IndividualBallot
soap:IndividualBallot rdf:type owl:Class ;
                      rdfs:subClassOf soap:Ballot ;
                      rdfs:label "Individual Ballot"@en .


###  http://www.semanticweb.org/soap#Option
soap:Option rdf:type owl:Class ;
            rdfs:subClassOf owl:Thing ;
            rdfs:comment "An abstract alternative over which preferences can be expressed within a decision making context, such as a candidate, item, or outcome. Options represent universal choice possibilities that may be made available in one or more contexts and referenced by ballots, but do not themselves carry contextual attributes such as rank or category."@en ;
            rdfs:label "Option"@en ;
            skos:altLabel "Alternative"@en ,
                          "Candidate"@en ,
                          "Choice"@en ,
                          "Party"@en ,
                          "Proposal"@en ,
                          "Survey Item"@en .


###  http://www.semanticweb.org/soap#RankedBallot
soap:RankedBallot rdf:type owl:Class ;
                  rdfs:subClassOf soap:Ballot ;
                  rdfs:comment "A ballot in which an agent expresses preferences by ordering options relative to one another. This class captures preference expressions that convey comparative ranking without prescribing how ties, weights, or completeness are represented."@en ;
                  rdfs:label "Ranked Ballot"@en .


###  http://www.semanticweb.org/soap#Result
soap:Result rdf:type owl:Class ;
            rdfs:subClassOf owl:Thing ;
            rdfs:comment "An outcome derived from one or more preference expressions within a context. Results are modeled separately from ballots to distinguish collective outcomes from individual inputs and to enable querying and analysis of decision outputs alongside preference data."@en ;
            rdfs:label "Result"@en ;
            skos:altLabel "Outcome"@en ,
                          "Output"@en ,
                          "Resolution"@en ,
                          "Verdict"@en .


