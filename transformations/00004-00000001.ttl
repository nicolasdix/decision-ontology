data:bo/00004-00000001/1/3 a do:BallotOption ;
  do:refersToOption data:option/00004-00000001/3 ;
  do:optionRank "3"^^xsd:int .

data:agent/00004-00000001/1 a do:Agent ;
  rdfs:label "Synthetic agent 1 (00004-00000001)" ;
  do:hasExpressed data:ballot/00004-00000001/1 .

