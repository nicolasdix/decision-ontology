@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:context/00004-00000001 a do:Context ;
  rdfs:label "Netflix Prize Data" .

data:context/00004-00000001 do:hasAvailableOption data:option/00004-00000001/1, data:option/00004-00000001/2, data:option/00004-00000001/3 .

data:option/00004-00000001/1 a do:Option ; rdfs:label "Shrek (Full-screen)" .
data:option/00004-00000001/2 a do:Option ; rdfs:label "The X-Files: Season 2" .
data:option/00004-00000001/3 a do:Option ; rdfs:label "The Punisher" .

data:ballot/00004-00000001/1 a do:Ballot, do:RankedBallot, do:CompleteBallot, do:AggregatedBallot ;
  do:hasContext data:context/00004-00000001 ;
  do:hasMultiplicity "263"^^xsd:int ;
  do:hasBallotOption data:bo/00004-00000001/1/2, data:bo/00004-00000001/1/1, data:bo/00004-00000001/1/3 .

data:bo/00004-00000001/1/2 a do:BallotOption ;
  do:refersToOption data:option/00004-00000001/2 ;
  do:optionRank "1"^^xsd:int .

data:bo/00004-00000001/1/1 a do:BallotOption ;
  do:refersToOption data:option/00004-00000001/1 ;
